# Copy to .env for local development. On Replit, add these values with Tools > Secrets.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Optional. Defaults to the current Replit HTTPS domain when available.
# Set to your public HTTPS app URL before using the bot's Web App button.
TELEGRAM_WEBAPP_URL=

# Optional Claude model override.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
